if(NOT DEFINED SAT_PAK OR NOT DEFINED SAT_DEST)
    message(FATAL_ERROR "StagePak requires SAT_PAK and SAT_DEST")
endif()
file(STRINGS "${SAT_PAK}.parts" parts ENCODING UTF-8)
get_filename_component(source_dir "${SAT_PAK}" DIRECTORY)
file(MAKE_DIRECTORY "${SAT_DEST}")
foreach(part IN LISTS parts)
    if(part MATCHES "[/\\\\]" OR part MATCHES "^\\.\\.")
        message(FATAL_ERROR "Invalid pak part filename")
    endif()
    file(COPY_FILE "${source_dir}/${part}" "${SAT_DEST}/${part}" ONLY_IF_DIFFERENT)
endforeach()
