cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED SAT_PAK OR NOT DEFINED SAT_DEST)
    message(FATAL_ERROR "StagePak requires SAT_PAK and SAT_DEST")
endif()
file(STRINGS "${SAT_PAK}.parts" parts ENCODING UTF-8)
get_filename_component(source_dir "${SAT_PAK}" DIRECTORY)
file(MAKE_DIRECTORY "${SAT_DEST}")
get_filename_component(archive_name "${SAT_PAK}" NAME)
get_filename_component(archive_stem "${SAT_PAK}" NAME_WLE)
foreach(part IN LISTS parts)
    if(part MATCHES "[/\\\\]" OR part MATCHES "^\\.\\.")
        message(FATAL_ERROR "Invalid pak part filename")
    endif()
    file(COPY_FILE "${source_dir}/${part}" "${SAT_DEST}/${part}" ONLY_IF_DIFFERENT)
endforeach()
# Only remove parts tracked by a prior staging of this archive set.
set(staged_manifest "${SAT_DEST}/${archive_name}.parts")
if(EXISTS "${staged_manifest}")
    file(STRINGS "${staged_manifest}" previous ENCODING UTF-8)
    string(LENGTH "${archive_stem}" stem_length)
    foreach(part IN LISTS previous)
        if(part IN_LIST parts)
            continue()
        endif()
        string(FIND "${part}" "${archive_stem}." prefix)
        if(prefix EQUAL 0)
            string(SUBSTRING "${part}" ${stem_length} -1 suffix)
            if(suffix MATCHES "^([.](assets|audio|textures))?([.][0-9]+)?[.]pak$")
                file(REMOVE "${SAT_DEST}/${part}")
            endif()
        endif()
    endforeach()
endif()
file(COPY_FILE "${SAT_PAK}.parts" "${staged_manifest}" ONLY_IF_DIFFERENT)
