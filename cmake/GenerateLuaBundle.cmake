# Encode bytes rather than C++ string literals: quotes, backslashes, Unicode,
# NULs and long lines round-trip exactly, without MSVC string literal limits.
function(byte_array name path output)
    file(READ "${path}" bytes HEX)
    string(REPEAT "[0-9a-f]" 32 row_pattern)
    string(REGEX REPLACE "(${row_pattern})" "\\1\n" bytes "${bytes}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    set(${output} "constexpr unsigned char ${name}[] = {${bytes}0};\n" PARENT_SCOPE)
endfunction()
file(GLOB_RECURSE scripts RELATIVE "${SAT_SCRIPT_ROOT}" "${SAT_SCRIPT_ROOT}/*.lua")
list(SORT scripts)
set(code "#include \"EmbeddedLuaProject.hpp\"\n#include <array>\nnamespace sat {\nnamespace {\n")
set(entries "")
set(index 0)
foreach(script IN LISTS scripts)
    byte_array(source${index} "${SAT_SCRIPT_ROOT}/${script}" declaration)
    string(APPEND code "${declaration}")
    string(HEX "${script}" name_bytes)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," name_bytes "${name_bytes}")
    string(APPEND code "constexpr unsigned char name${index}[] = {${name_bytes}0};\n")
    string(APPEND entries "    LuaScriptSource{std::string_view(reinterpret_cast<const char*>(name${index}), sizeof(name${index}) - 1), std::string_view(reinterpret_cast<const char*>(source${index}), sizeof(source${index}) - 1)},\n")
    math(EXPR index "${index} + 1")
endforeach()
byte_array(sceneSource "${SAT_SCENE_FILE}" scene_declaration)
string(APPEND code "${scene_declaration}")
string(APPEND code "const std::array<LuaScriptSource, ${index}> kScripts{{\n${entries}}};\n}\nstd::span<const LuaScriptSource> embeddedLuaScripts() { return kScripts; }\nstd::string_view embeddedLuaScene() { return {reinterpret_cast<const char*>(sceneSource), sizeof(sceneSource) - 1}; }\n}\n")
file(WRITE "${SAT_OUTPUT}" "${code}")
