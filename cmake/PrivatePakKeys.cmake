cmake_policy(PUSH)
if(POLICY CMP0152)
    cmake_policy(SET CMP0152 NEW)
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
if(NOT DEFINED SAT_PRIVATE_ROOT)
    if(DEFINED ENV{SAT_PRIVATE_ROOT})
        set(SAT_PRIVATE_ROOT "$ENV{SAT_PRIVATE_ROOT}" CACHE PATH "External private build tools and generated secrets")
    elseif(WIN32)
        set(SAT_PRIVATE_ROOT "$ENV{USERPROFILE}/Desktop/SatEnginePrivate" CACHE PATH "External private build tools and generated secrets")
    else()
        set(SAT_PRIVATE_ROOT "$ENV{HOME}/Desktop/SatEnginePrivate" CACHE PATH "External private build tools and generated secrets")
    endif()
endif()
file(REAL_PATH "${SAT_PRIVATE_ROOT}" SAT_PRIVATE_ROOT EXPAND_TILDE)
foreach(forbidden "${PROJECT_SOURCE_DIR}" "${CMAKE_BINARY_DIR}" "${SAT_GAME_PROJECT}")
    get_filename_component(forbidden "${forbidden}" ABSOLUTE)
    cmake_path(IS_PREFIX forbidden "${SAT_PRIVATE_ROOT}" NORMALIZE inside)
    if(inside)
        message(FATAL_ERROR "SAT_PRIVATE_ROOT must be outside the checkout, build directory and game project")
    endif()
endforeach()
if(NOT DEFINED SAT_RELEASE_ID OR SAT_RELEASE_ID STREQUAL "")
    if(DEFINED ENV{SAT_RELEASE_ID} AND NOT "$ENV{SAT_RELEASE_ID}" STREQUAL "")
        set(SAT_RELEASE_ID "$ENV{SAT_RELEASE_ID}" CACHE STRING "Public release identifier")
    else()
        string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef release_id)
        set(SAT_RELEASE_ID "${release_id}" CACHE STRING "Public release identifier")
    endif()
endif()
option(SAT_ENABLE_OBFUSCATION "Use an available external private obfuscator" ON)
set(SAT_OBFUSCATOR_DIR "" CACHE PATH "Optional external folder containing the private generate.py")
if(SAT_OBFUSCATOR_DIR STREQUAL "")
    set(private_generator "${SAT_PRIVATE_ROOT}/generate.py")
else()
    set(private_generator "${SAT_OBFUSCATOR_DIR}/generate.py")
endif()
if(SAT_ENABLE_OBFUSCATION AND EXISTS "${private_generator}")
    set(key_generator "${private_generator}")
    message(STATUS "Standalone keys: private obfuscation provider")
else()
    set(key_generator "${PROJECT_SOURCE_DIR}/scripts/generate_release_keys.py")
    message(STATUS "Standalone keys: obfuscation disabled or tool unavailable; using unobfuscated encrypted-archive provider")
endif()
string(SHA256 key_identity "${SAT_GAME_PROJECT}|${CMAKE_BINARY_DIR}|${SAT_RELEASE_ID}|${key_generator}")
set(pak_keys "${SAT_PRIVATE_ROOT}/generated/${key_identity}")
set(pak_provider "${pak_keys}/GamePakKeys.cpp")
# Reconfigure if a private tool is installed/removed after initial configuration.
file(GLOB private_tool_watch CONFIGURE_DEPENDS "${private_generator}")
add_custom_command(OUTPUT "${pak_provider}" "${pak_keys}/scripts.bin" "${pak_keys}/textures.bin"
        "${pak_keys}/audio.bin" "${pak_keys}/assets.bin"
    COMMAND "${Python3_EXECUTABLE}" "${key_generator}" --project "${SAT_GAME_PROJECT}"
        --release "${SAT_RELEASE_ID}" --output "${pak_keys}"
    DEPENDS "${key_generator}" VERBATIM)
target_sources(GamePlayer PRIVATE "${pak_provider}")

cmake_policy(POP)
