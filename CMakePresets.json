{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio 2026)",
      "description": "Configures SatEngine with the installed Visual Studio 2026 x64 toolset.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-gameplayer",
      "inherits": "windows",
      "displayName": "Windows standalone game player (no editor)",
      "binaryDir": "${sourceDir}/build-gameplayer",
      "cacheVariables": {
        "SAT_BUILD_GAME_PLAYER": "ON",
        "SAT_BUILD_EDITOR": "OFF",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "windows-gameplayer-debug",
      "configurePreset": "windows-gameplayer",
      "configuration": "Debug",
      "targets": [
        "GamePlayer"
      ]
    },
    {
      "name": "windows-gameplayer-release",
      "configurePreset": "windows-gameplayer",
      "configuration": "Release",
      "targets": [
        "GamePlayer"
      ]
    }
  ]
}
